{
  "name": "aethel-ledger",
  "image": "mcr.microsoft.com/devcontainers/go:1.22",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.testFlags": ["-race", "-v"],
        "go.lintTool": "golangci-lint"
      }
    }
  },
  "postCreateCommand": "go mod tidy",
  "forwardPorts": [50051]
}
